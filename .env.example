# Copie este arquivo para .env e preencha com os valores reais.
# NÃO coloque credenciais reais neste arquivo de exemplo.

# --- Banco de dados (Neon) ---
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST.neon.tech/NOME_DO_BANCO?sslmode=require

# --- Login do administrador ---
ADMIN_USUARIO=admin
# Opção 1 (mais simples para desenvolvimento): senha em texto.
ADMIN_SENHA=troque-esta-senha
# Opção 2 (recomendada para o deploy): hash bcrypt da senha. Se preenchido,
# tem prioridade sobre ADMIN_SENHA. Gere com:
#   python -c "from app.core.seguranca import gerar_hash_senha; print(gerar_hash_senha('SUA_SENHA'))"
# ADMIN_SENHA_HASH=

# --- Token JWT ---
# Chave para assinar o token. Gere uma longa e aleatória para o deploy, ex.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-esta-chave-no-deploy
JWT_EXPIRA_HORAS=8
